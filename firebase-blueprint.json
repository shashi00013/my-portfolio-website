{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "Messages sent by users to admin",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "content": { "type": "string" },
        "adminReply": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "content", "status", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Logs of user and admin actions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of user messages"
    },
    "activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection of system activity logs"
    }
  }
}
